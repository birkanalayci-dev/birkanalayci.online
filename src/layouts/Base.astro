---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, SAME_AS, LANGS, type Lang } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** TR ve EN eşdeğer yolları (zorunlu) */
  trHref: string;
  enHref: string;
  ogImage?: string;
  /** <body> üzerine eklenecek sınıf (ör. koyu "Velo" teması) */
  bodyClass?: string;
  /** Arama motorlarından gizle (ör. akademik dışı Velo sayfası) */
  noindex?: boolean;
}

const {
  title,
  description,
  lang = 'tr',
  trHref,
  enHref,
  ogImage = '/portrait.jpg',
  bodyClass,
  noindex = false,
} = Astro.props;

const base = SITE.domain;
const canonical = new URL(Astro.url.pathname, base).href;
const ogImageAbs = new URL(ogImage, base).href;
const ogLocaleMap: Record<Lang, string> = { tr: 'tr_TR', en: 'en_US' };

// Dil → eşdeğer yol haritası (hreflang + dil değiştirici).
const altMap: Record<Lang, string> = { tr: trHref, en: enHref };
const siteName = lang === 'tr' ? SITE.nameTr : SITE.nameEn;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Birkan Alaycı',
  honorificPrefix: 'Dr.',
  honorificSuffix: 'MD',
  jobTitle: lang === 'tr' ? 'İç hastalıkları uzmanı' : 'Internal medicine specialist',
  description:
    lang === 'tr'
      ? 'İç hastalıkları uzmanı; Koç Üniversitesi Hastanesi Klinik Araştırmalar Ünitesi’nde sub-investigator, İstinye Üniversitesi’nde moleküler onkoloji doktora öğrencisi.'
      : 'Internal medicine specialist; sub-investigator at the Clinical Trials Unit, Koç University Hospital, and PhD student in molecular oncology at İstinye University.',
  url: base,
  image: ogImageAbs,
  worksFor: {
    '@type': 'Organization',
    name: 'Koç University Hospital',
    department: { '@type': 'Organization', name: 'Clinical Trials Unit' },
  },
  affiliation: [
    { '@type': 'Organization', name: 'Koç University Hospital' },
    { '@type': 'CollegeOrUniversity', name: 'İstinye University' },
  ],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Dokuz Eylül Üniversitesi Tıp Fakültesi' },
  ],
  knowsAbout: ['Internal medicine', 'Clinical trials'],
  sameAs: SAME_AS,
};
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:wght@500;600;700&display=swap"
    />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => (
      <link rel="alternate" hreflang={l.code} href={new URL(altMap[l.code], base).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(altMap.tr, base).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocaleMap[lang]} />
    <meta property="og:image" content={ogImageAbs} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <meta name="theme-color" content="#1f6f78" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="yandex-verification" content="2d34b6832a906a4b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">{lang === 'tr' ? 'İçeriğe geç' : 'Skip to content'}</a>
    <Header lang={lang} alts={altMap} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
