---
import { NAV, LINKS, SHOW_PERSONAL_PAGE, UI, type Lang } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang];

const items = NAV.map((n) => n[lang]);
const year = new Date().getFullYear();

const personalHref = lang === 'tr' ? '/kisisel/' : '/en/personal/';
const personalLabel = 'Velo';
const profilesLabel = lang === 'tr' ? 'Akademik profiller' : 'Academic profiles';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <p style="color:var(--text);font-weight:600;font-family:var(--serif);">{t.name}</p>
      <p class="small">{t.affiliation} · {t.city}</p>
    </div>

    <nav aria-label={t.mainMenu}>
      <ul class="footer-links">
        {items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        {SHOW_PERSONAL_PAGE && (
          <li><a href={personalHref} class="muted">{personalLabel}</a></li>
        )}
      </ul>
    </nav>

    <nav aria-label={profilesLabel}>
      <ul class="footer-links">
        <li><a href={LINKS.orcid} target="_blank" rel="noopener">ORCID</a></li>
        <li><a href={LINKS.scholar} target="_blank" rel="noopener">Google Scholar</a></li>
        <li><a href={LINKS.researchgate} target="_blank" rel="noopener">ResearchGate</a></li>
        <li><a href={LINKS.github} target="_blank" rel="noopener">GitHub</a></li>
        <li><a href={LINKS.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
      </ul>
    </nav>
  </div>

  <div class="container" style="margin-top:1.5rem;">
    <p class="small muted">© {year} {t.name}. {t.rights}</p>
  </div>
</footer>
