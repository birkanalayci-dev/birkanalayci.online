---
import Base from '../../layouts/Base.astro';
import { HAS_PORTRAIT, LINKS, REPOS, SITE } from '../../data/site';
import { PUBLICATIONS } from '../../data/publications';

const title = 'Birkan Alaycı, MD — Clinical Research, Clinical Trials Unit, Koç University';
const description =
  'Birkan Alaycı, MD — internal medicine specialist working on clinical research, evidence synthesis and reproducible meta-analysis methodology at the Clinical Trials Unit, Koç University, Istanbul.';

const featured = PUBLICATIONS.filter((p) => p.type === 'preprint' || p.type === 'article').slice(0, 2);
---

<Base {title} {description} lang="en" trHref="/" enHref="/en/">
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Clinical research · {SITE.cityEn}</p>
        <h1>{SITE.nameEn}</h1>
        <p class="affil">{SITE.affiliationEn}</p>
        <p class="lead">
          Internal medicine specialist. I work on turning clinical questions into
          analysable research designs, synthesising evidence transparently and
          reproducibly, and keeping conclusions within what the data can support.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="/en/research/">Research &amp; publications</a>
          <a class="btn btn-secondary" href="/en/about/">About</a>
        </div>
      </div>

      <div class="portrait-wrap">
        {
          HAS_PORTRAIT && (
            <img
              class="portrait"
              src="/portrait.webp"
              width="760"
              height="912"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              alt="Birkan Alaycı, MD"
            />
          )
        }
      </div>
    </div>
  </section>

  <!-- CURRENTLY -->
  <section class="section" style="padding-top:0;">
    <div class="container">
      <p class="eyebrow">Currently</p>
      <div class="grid grid-3 mt-2">
        <div class="card">
          <h3>Clinical Trials Unit</h3>
          <p>
            Working on clinical trials at the Clinical Trials Unit, Koç University
            (September 2026 – ).
          </p>
        </div>
        <div class="card">
          <h3>PhD in Molecular Oncology</h3>
          <p>
            İstinye University, Institute of Graduate Studies — PhD Programme in
            Molecular Oncology (2026 – ).
          </p>
        </div>
        <div class="card">
          <h3>Evidence synthesis methodology</h3>
          <p>
            Traceable, reproducible workflows for systematic reviews and
            meta-analyses; open data and open code.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- RESEARCH AREAS -->
  <section class="section" style="padding-top:0;">
    <div class="container">
      <p class="eyebrow">Research areas</p>
      <ul class="tag-row mt-2">
        <li class="tag-chip">Clinical trials</li>
        <li class="tag-chip">Evidence synthesis &amp; meta-analysis</li>
        <li class="tag-chip">Reproducible research</li>
        <li class="tag-chip">Metabolic medicine &amp; body composition</li>
        <li class="tag-chip">Molecular oncology</li>
      </ul>
    </div>
  </section>

  <!-- SELECTED WORK -->
  <section class="section" style="padding-top:0;">
    <div class="container">
      <p class="eyebrow">Selected work</p>
      <div class="grid grid-2 mt-2">
        {
          featured.map((p) => (
            <article class="card">
              <p class="small muted">{p.venue} · {p.year}</p>
              <h3 class="mt-1" style="font-size:1.05rem;line-height:1.35;">
                {p.url ? <a href={p.url} target="_blank" rel="noopener" style="color:inherit;text-decoration:none;">{p.title}</a> : p.title}
              </h3>
            </article>
          ))
        }
        {
          REPOS.map((r) => (
            <article class="card">
              <p class="small muted">GitHub · open source</p>
              <h3 class="mt-1" style="font-size:1.05rem;">
                <a href={r.url} target="_blank" rel="noopener" style="color:inherit;text-decoration:none;">{r.name}</a>
              </h3>
              <p class="mt-1">{r.desc.en}</p>
            </article>
          ))
        }
      </div>
      <div class="cta-row mt-3">
        <a class="btn btn-secondary" href="/en/research/">All publications and projects</a>
        <a class="btn btn-secondary" href={LINKS.orcid} target="_blank" rel="noopener">ORCID</a>
      </div>
    </div>
  </section>
</Base>
