---
import Base from '../../layouts/Base.astro';
import { LINKS, SITE } from '../../data/site';

const title = 'Contact — Birkan Alaycı, MD';
const description =
  'Academic and professional contact for Birkan Alaycı, MD: LinkedIn, ORCID, Google Scholar, ResearchGate and GitHub profiles. Clinical Trials Unit, Koç University.';
---

<Base {title} {description} lang="en" trHref="/iletisim/" enHref="/en/contact/">
  <section class="section">
    <div class="container prose">
      <p class="eyebrow">Contact</p>
      <h1>Academic &amp; professional contact</h1>
      <p class="lead mt-2">
        For research collaboration, publications and academic matters, please use
        the channels below.
      </p>

      <ul class="linklist mt-4">
        <li><a href={LINKS.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href={LINKS.orcid} target="_blank" rel="noopener">ORCID</a></li>
        <li><a href={LINKS.scholar} target="_blank" rel="noopener">Google Scholar</a></li>
        <li><a href={LINKS.researchgate} target="_blank" rel="noopener">ResearchGate</a></li>
        <li><a href={LINKS.github} target="_blank" rel="noopener">GitHub</a></li>
      </ul>

      <div class="note mt-4">
        <strong>Affiliation:</strong> {SITE.affiliationEn}, {SITE.cityEn}.
      </div>

      <p class="small muted mt-4">
        This website does not offer consultations, appointments or medical advice.
      </p>
    </div>
  </section>
</Base>
