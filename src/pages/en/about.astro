---
import Base from '../../layouts/Base.astro';
import AppointmentBanner from '../../components/AppointmentBanner.astro';

const title = 'About — Birkan Alaycı, MD, Internal Medicine Specialist';
const description =
  'About Birkan Alaycı, MD: clinical approach in internal medicine, education and career, PhD programme in molecular oncology, professional memberships.';
---

<Base {title} {description} lang="en" trHref="/hakkimda/" enHref="/en/about/">
  <section class="section">
    <div class="container prose">
      <p class="eyebrow">About</p>
      <h1>Birkan Alaycı, MD</h1>
      <p class="lead mt-2">
        Internal medicine specialist practicing at Liv Hospital Vadistanbul,
        Istanbul.
      </p>
      <p class="mt-3">
        My clinical work focuses on obesity, metabolic syndrome, diabetes, thyroid
        disorders and preventive health. It is shaped by evidence-based diagnostics,
        coordination of multimorbid patients, and pattern recognition that emerges
        from close engagement with each patient. Whether deciding at the bedside or
        weighing scientific evidence, I follow the same principle: break the picture
        into its parts, weigh the findings methodically, and place the clinical
        decision within a clear framework.
      </p>

      <h2 class="mt-4">Education &amp; career</h2>
      <ul class="timeline mt-2">
        <li><strong>Doctor of Medicine</strong> — Dokuz Eylül University Faculty of Medicine, İzmir (2012–2018)</li>
        <li><strong>Internal Medicine residency</strong> — University of Health Sciences, Şişli Hamidiye Etfal Training and Research Hospital, Istanbul (2018–2023)</li>
        <li><strong>Internal Medicine Specialist</strong> — Ardanuç State Hospital, Artvin (2023–2025)</li>
        <li><strong>Internal Medicine Specialist</strong> — Liv Hospital Vadistanbul, Istanbul (November 2025 – present)</li>
        <li><strong>PhD Programme in Molecular Oncology</strong> — İstinye University, Institute of Graduate Studies (2026 – present)</li>
      </ul>

      <h2 class="mt-4">Professional memberships</h2>
      <ul class="mt-2">
        <li>American College of Physicians (ACP)</li>
        <li>Türk İç Hastalıkları Uzmanlık Derneği (TİHUD)</li>
        <li>Dahiliye Uzmanları Derneği (DAHUDER)</li>
      </ul>
    </div>
  </section>

  <AppointmentBanner lang="en" />
</Base>
