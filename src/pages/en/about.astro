---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site';

const title = 'About — Birkan Alaycı, MD';
const description =
  'About Birkan Alaycı, MD: internal medicine training, clinical research at the Clinical Trials Unit of Koç University, PhD programme in molecular oncology, education and career.';
---

<Base {title} {description} lang="en" trHref="/hakkimda/" enHref="/en/about/">
  <section class="section">
    <div class="container prose">
      <p class="eyebrow">About</p>
      <h1>{SITE.nameEn}</h1>
      <p class="lead mt-2">
        Internal medicine specialist. Since September 2026 I work on clinical
        trials at the Clinical Trials Unit, Koç University, and I am a PhD student
        in Molecular Oncology at İstinye University.
      </p>

      <p class="mt-3">
        I trained in medicine at Dokuz Eylül University and completed my internal
        medicine residency at Şişli Hamidiye Etfal Training and Research Hospital.
        I then worked as an internal medicine specialist at a district state
        hospital in Ardanuç, Artvin, and at Liv Hospital Vadistanbul in Istanbul.
        My focus today is not active clinical practice but clinical research and
        evidence synthesis.
      </p>
      <p>
        Three things define how I work: turning clinical questions into
        analysable research designs, finding the weak point in a method, and
        interpreting results within the limits the data can support. I build
        reproducible, auditable workflows for systematic reviews and
        meta-analyses, and share data and code openly wherever possible.
      </p>

      <h2 class="mt-4">Education &amp; career</h2>
      <ul class="timeline mt-2">
        <li><strong>Doctor of Medicine</strong> — Dokuz Eylül University Faculty of Medicine, İzmir (2012–2018)</li>
        <li><strong>Internal Medicine residency</strong> — University of Health Sciences, Şişli Hamidiye Etfal Training and Research Hospital, Istanbul (2018–2023)</li>
        <li><strong>Internal Medicine Specialist</strong> — Ardanuç State Hospital, Artvin (2023–2025)</li>
        <li><strong>Internal Medicine Specialist</strong> — Liv Hospital Vadistanbul, Istanbul (November 2025 – September 2026)</li>
        <li><strong>PhD Programme in Molecular Oncology</strong> — İstinye University, Institute of Graduate Studies (2026 – present)</li>
        <li><strong>Clinical Trials Unit</strong> — Koç University, Istanbul (September 2026 – present)</li>
      </ul>

      <h2 class="mt-4">Professional memberships</h2>
      <ul class="mt-2">
        <li>American College of Physicians (ACP)</li>
        <li>Türk İç Hastalıkları Uzmanlık Derneği (TİHUD)</li>
        <li>Dahiliye Uzmanları Derneği (DAHUDER)</li>
      </ul>
    </div>
  </section>
</Base>
