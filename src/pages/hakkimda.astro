---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';

const title = 'Hakkımda — Dr. Birkan Alaycı';
const description =
  'Dr. Birkan Alaycı hakkında: iç hastalıkları uzmanlığı, Koç Üniversitesi Hastanesi Clinical Trials Unit’teki klinik araştırma görevi, moleküler onkoloji doktora programı, eğitim ve kariyer çizgisi.';
---

<Base {title} {description} lang="tr" trHref="/hakkimda/" enHref="/en/about/">
  <section class="section">
    <div class="container prose">
      <p class="eyebrow">Hakkımda</p>
      <h1>{SITE.nameTr}</h1>
      <p class="lead mt-2">
        İç hastalıkları uzmanıyım. Ekim 2026’dan beri Koç Üniversitesi Hastanesi
        Klinik Araştırmalar Ünitesi’nde sub-investigator olarak çalışıyorum;
        görevlendirildiğim araştırmalarda katılımcıları muayene ediyorum. Aynı
        zamanda İstinye Üniversitesi’nde moleküler onkoloji doktora öğrencisiyim.
      </p>

      <p class="mt-3">
        Tıp eğitimimi Dokuz Eylül Üniversitesi’nde, iç hastalıkları uzmanlık
        eğitimimi Şişli Hamidiye Etfal Eğitim ve Araştırma Hastanesi’nde
        tamamladım. Uzmanlık tezim D vitamini eksikliğinde parathormon (PTH)
        yanıtı üzerineydi. Sonrasında Artvin Ardanuç’ta ilçe devlet hastanesinde
        ve İstanbul’da Liv Hospital Vadistanbul’da iç hastalıkları uzmanı olarak
        çalıştım.
      </p>

      <h2 class="mt-4">Eğitim &amp; kariyer</h2>
      <ul class="timeline mt-2">
        <li><strong>Tıp Doktoru</strong> — Dokuz Eylül Üniversitesi Tıp Fakültesi, İzmir (2012–2018)</li>
        <li><strong>İç Hastalıkları uzmanlık eğitimi</strong> — SBÜ Şişli Hamidiye Etfal Eğitim ve Araştırma Hastanesi, İstanbul (2018–2023)</li>
        <li><strong>İç Hastalıkları Uzmanı</strong> — Ardanuç İlçe Devlet Hastanesi, Artvin (2023–2025)</li>
        <li><strong>İç Hastalıkları Uzmanı</strong> — Liv Hospital Vadistanbul, İstanbul (Kasım 2025 – Eylül 2026)</li>
        <li><strong>Moleküler Onkoloji Doktora Programı</strong> — İstinye Üniversitesi, Lisansüstü Eğitim Enstitüsü (2026 – devam)</li>
        <li><strong>Sub-Investigator, Clinical Trials Unit</strong> — Koç Üniversitesi Hastanesi, İstanbul (Ekim 2026 – devam)</li>
      </ul>

      <h2 class="mt-4">Yeterlilik ve sertifikalar</h2>
      <ul class="mt-2">
        <li>İç Hastalıkları Uzmanlık Yeterlilik Sınavı başarı sertifikası — Türk İç Hastalıkları Uzmanlık Derneği (TİHUD), 2026</li>
        <li>İyi Klinik Uygulamalar (GCP), ICH E6(R3) — The Global Health Network, 2026</li>
        <li>İyi Klinik Uygulamalar (GCP), Version 6 — NIDA Clinical Trials Network, 2026</li>
        <li>Primer on Evidence Synthesis — CABI Academy, 2026</li>
      </ul>

      <h2 class="mt-4">Mesleki üyelikler</h2>
      <ul class="mt-2">
        <li>American College of Physicians (ACP)</li>
        <li>American Association for Cancer Research (AACR) — Associate Member</li>
        <li>European Organisation for Research and Treatment of Cancer (EORTC) — Affiliate Member</li>
        <li>European Society of Endocrinology (ESE)</li>
        <li>Türk İç Hastalıkları Uzmanlık Derneği (TİHUD)</li>
        <li>TİHUD Genç Dahiliyeciler Grubu</li>
        <li>Dahiliye Uzmanları Derneği (DAHUDER)</li>
      </ul>
    </div>
  </section>
</Base>
