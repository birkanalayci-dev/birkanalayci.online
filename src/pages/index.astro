---
import Base from '../layouts/Base.astro';
import { HAS_PORTRAIT, LINKS, REPOS, SITE } from '../data/site';
import { PUBLICATIONS } from '../data/publications';

const title = 'Dr. Birkan Alaycı — Klinik Araştırma, Koç Üniversitesi Hastanesi Clinical Trials Unit';
const description =
  'Dr. Birkan Alaycı, iç hastalıkları uzmanı. Koç Üniversitesi Hastanesi Klinik Araştırmalar Ünitesi’nde çalışıyor; İstinye Üniversitesi’nde moleküler onkoloji doktora öğrencisi.';

const featured = PUBLICATIONS.filter((p) => p.type === 'preprint' || p.type === 'article').slice(0, 2);
---

<Base {title} {description} lang="tr" trHref="/" enHref="/en/">
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Klinik araştırma · {SITE.cityTr}</p>
        <h1>{SITE.nameTr}</h1>
        <p class="affil">{SITE.affiliationTr}</p>
        <p class="lead">
          İç hastalıkları uzmanıyım. Koç Üniversitesi Hastanesi Klinik Araştırmalar
          Ünitesi’nde çalışıyorum ve İstinye Üniversitesi’nde moleküler onkoloji
          doktora öğrencisiyim.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="/arastirma/">Araştırma &amp; yayınlar</a>
          <a class="btn btn-secondary" href="/hakkimda/">Hakkımda</a>
        </div>
      </div>

      <div class="portrait-wrap">
        {
          HAS_PORTRAIT && (
            <img
              class="portrait"
              src="/portrait.webp"
              width="760"
              height="912"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              alt="Dr. Birkan Alaycı"
            />
          )
        }
      </div>
    </div>
  </section>

  <!-- ŞU ANDA -->
  <section class="section" style="padding-top:0;">
    <div class="container">
      <p class="eyebrow">Şu anda</p>
      <div class="grid grid-2 mt-2">
        <div class="card">
          <h3>Clinical Trials Unit</h3>
          <p>
            Ekim 2026’dan beri sub-investigator olarak çalışıyorum.
            Görevlendirildiğim araştırmalarda katılımcıları muayene ediyorum;
            bunların çoğu erken faz onkoloji çalışması.
          </p>
        </div>
        <div class="card">
          <h3>Moleküler onkoloji doktorası</h3>
          <p>
            İstinye Üniversitesi Lisansüstü Eğitim Enstitüsü, Moleküler Onkoloji
            Doktora Programı (2026 – ).
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- İLGİ ALANLARI -->
  <section class="section" style="padding-top:0;">
    <div class="container">
      <p class="eyebrow">İlgi alanları</p>
      <ul class="tag-row mt-2">
        <li class="tag-chip">Klinik araştırmalar</li>
        <li class="tag-chip">Metabolik tıp ve vücut kompozisyonu</li>
        <li class="tag-chip">Moleküler onkoloji</li>
      </ul>
    </div>
  </section>

  <!-- SEÇİLMİŞ ÇALIŞMALAR -->
  <section class="section" style="padding-top:0;">
    <div class="container">
      <p class="eyebrow">Seçilmiş çalışmalar</p>
      <div class="grid grid-2 mt-2">
        {
          featured.map((p) => (
            <article class="card">
              <p class="small muted">{p.venue} · {p.year}</p>
              <h3 class="mt-1" style="font-size:1.05rem;line-height:1.35;">
                {p.url ? <a href={p.url} target="_blank" rel="noopener" style="color:inherit;text-decoration:none;">{p.title}</a> : p.title}
              </h3>
            </article>
          ))
        }
        {
          REPOS.map((r) => (
            <article class="card">
              <p class="small muted">GitHub · açık kaynak</p>
              <h3 class="mt-1" style="font-size:1.05rem;">
                <a href={r.url} target="_blank" rel="noopener" style="color:inherit;text-decoration:none;">{r.name}</a>
              </h3>
              <p class="mt-1">{r.desc.tr}</p>
            </article>
          ))
        }
      </div>
      <div class="cta-row mt-3">
        <a class="btn btn-secondary" href="/arastirma/">Tüm yayınlar ve projeler</a>
        <a class="btn btn-secondary" href={LINKS.orcid} target="_blank" rel="noopener">ORCID</a>
      </div>
    </div>
  </section>
</Base>
