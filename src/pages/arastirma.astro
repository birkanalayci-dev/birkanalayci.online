---
import Base from '../layouts/Base.astro';
import PublicationList from '../components/PublicationList.astro';
import { LINKS, REPOS } from '../data/site';

const title = 'Araştırma & Yayınlar — Dr. Birkan Alaycı';
const description =
  'Dr. Birkan Alaycı’nın yayınları ve poster bildirileri; ORCID, Google Scholar ve ResearchGate profilleri.';
---

<Base {title} {description} lang="tr" trHref="/arastirma/" enHref="/en/research/">
  <section class="section">
    <div class="container prose">
      <p class="eyebrow">Araştırma</p>
      <h1>Araştırma &amp; yayınlar</h1>

      <p class="lead mt-2">
        Yayımlanmış makalelerim arasında inkretin temelli tedavilerle DXA ile
        ölçülen yağsız ve yağ kütlesi farklarını inceleyen bir meta-analiz (2026),
        trimetoprim-sülfametoksazolle ilişkili tip 4 renal tübüler asidoz olgusu
        (2025) ve Paget kemik hastalığında metabolik sendrom sıklığını inceleyen
        bir çalışma (2022) var. Ayrıca allojenik hematopoetik kök hücre nakli
        sonuçları üzerine COSTEM 2026’da kabul edilen üç poster bildirisinde ortak
        yazarım.
      </p>

      <p class="eyebrow mt-4">İlgi alanları</p>
      <ul class="tag-row mt-2">
        <li class="tag-chip">Klinik araştırmalar</li>
        <li class="tag-chip">Metabolik tıp ve vücut kompozisyonu</li>
        <li class="tag-chip">Moleküler onkoloji</li>
      </ul>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <h2>Veri ve kod</h2>
      <div class="grid grid-2 mt-3">
        {
          REPOS.map((r) => (
            <article class="card">
              <h3 style="font-size:1.05rem;">
                <a href={r.url} target="_blank" rel="noopener" style="color:inherit;text-decoration:none;">{r.name}</a>
              </h3>
              <p class="mt-1">{r.desc.tr}</p>
              <ul class="tag-row mt-2">
                {r.tags.map((t) => <li class="tag-chip">{t}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <h2>Yayınlar</h2>
      <p class="muted mt-1">En güncel liste için ORCID ve Google Scholar profillerine bakınız.</p>
      <div class="mt-3">
        <PublicationList lang="tr" />
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <h2>Akademik profiller</h2>
      <ul class="linklist mt-2">
        <li><a href={LINKS.orcid} target="_blank" rel="noopener">ORCID</a></li>
        <li><a href={LINKS.scholar} target="_blank" rel="noopener">Google Scholar</a></li>
        <li><a href={LINKS.researchgate} target="_blank" rel="noopener">ResearchGate</a></li>
        <li><a href={LINKS.github} target="_blank" rel="noopener">GitHub</a></li>
        <li><a href={LINKS.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
      </ul>
    </div>
  </section>
</Base>
