---
import Base from '../layouts/Base.astro';
import { LINKS, SITE } from '../data/site';

const title = 'İletişim — Dr. Birkan Alaycı';
const description =
  'Dr. Birkan Alaycı ile akademik ve profesyonel iletişim: LinkedIn, ORCID, Google Scholar, ResearchGate ve GitHub profilleri. Koç Üniversitesi, Clinical Trials Unit.';
---

<Base {title} {description} lang="tr" trHref="/iletisim/" enHref="/en/contact/">
  <section class="section">
    <div class="container prose">
      <p class="eyebrow">İletişim</p>
      <h1>Akademik &amp; profesyonel iletişim</h1>
      <p class="lead mt-2">
        Araştırma iş birliği, yayın ve akademik konular için aşağıdaki kanalları
        kullanabilirsiniz.
      </p>

      <ul class="linklist mt-4">
        <li><a href={LINKS.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href={LINKS.orcid} target="_blank" rel="noopener">ORCID</a></li>
        <li><a href={LINKS.scholar} target="_blank" rel="noopener">Google Scholar</a></li>
        <li><a href={LINKS.researchgate} target="_blank" rel="noopener">ResearchGate</a></li>
        <li><a href={LINKS.github} target="_blank" rel="noopener">GitHub</a></li>
      </ul>

      <div class="note mt-4">
        <strong>Kurum:</strong> {SITE.affiliationTr}, {SITE.cityTr}.
      </div>

      <p class="small muted mt-4">
        Bu site üzerinden muayene, randevu veya tıbbi danışmanlık hizmeti
        verilmemektedir.
      </p>
    </div>
  </section>
</Base>
